# Server
PORT=8888
PUBLIC_BASE_URL=http://localhost:8888
DATABASE_PATH=./pansou.db
PROXY=

# Search
CHANNELS=Quark_Movies,Aliyun_4K_Movies,vip115hot,dianying4K,yunpanx,fcij5,mqte5,jxwpzy,QuarkFree,kduanju,quanwangzy,WPpindao,Netdisk_Movies,jnjy_5,FLMdongtianfudi,haoruanfenxiangresources,xuexiziliaobaibaoku,xvth5,xvth55006
CACHE_ENABLED=true
CACHE_PATH=/tmp/pansou_cache
CACHE_MAX_SIZE=100
CACHE_TTL=60
VALIDATE_LINKS=true
VALIDATE_TIMEOUT=3

# Auth for admin/API endpoints. Keep disabled for local testing.
AUTH_ENABLED=false
AUTH_USERS=admin:change-me
AUTH_TOKEN_EXPIRY=24
AUTH_JWT_SECRET=change-me-in-production

# WeChat Official Account
WECHAT_TOKEN=
WECHAT_APPID=
WECHAT_APPSECRET=

# Quark
# Never commit a real cookie.
QUARK_COOKIE=
QUARK_AUTO_TRANSFER=false
QUARK_CLICK_TRANSFER=true
# Keep true for local tests. Set false to use the real Quark web API.
QUARK_MOCK_TRANSFER=true
# Optional owner-folder fid. Empty/0 means save to root.
QUARK_SAVE_FOLDER_ID=
# 0 means no expiry if Quark accepts permanent share for the current account.
QUARK_SHARE_EXPIRE_DAYS=7
# Optional custom extraction/share password for generated owner links.
QUARK_SHARE_PASSWORD=
QUARK_TRANSFER_TIMEOUT=30
QUARK_TRANSFER_CONCURRENCY=2
QUARK_STORAGE_MIN_FREE_GB=100
QUARK_STORAGE_CLEANUP_ENABLED=true
QUARK_STORAGE_CLEANUP_KEEP_DAYS=7
QUARK_STORAGE_CLEANUP_MAX_ITEMS=20

# Scheduler
SCHEDULE_INTERVAL=30
SEARCH_MAX_RETRIES=6

# Discovery placeholders for the next phase.
DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_MINUTES=1440
DISCOVERY_SEED_KEYWORDS=电影,电视剧,综艺,动漫,纪录片
DISCOVERY_MAX_KEYWORDS_PER_RUN=20
DISCOVERY_MAX_RESULTS_PER_KEYWORD=10

# Continuous resource harvester. Gmail requires a Google App Password.
HARVEST_TARGET=500000
HARVEST_CYCLE_SECONDS=30
HARVEST_VALIDATION_BATCH=2000
HARVEST_TELEGRAM_PAGES=16
HARVEST_SOURCE_CONCURRENCY=8
HARVEST_KEYWORD_BATCH=500
HARVEST_PANSOU_KEYWORD_BATCH=500
HARVEST_VALIDATION_CONCURRENCY=12
HARVEST_AUTH_TELEGRAM_INTERVAL=600
HARVEST_AUTH_TELEGRAM_DIALOGS=100
HARVEST_AUTH_TELEGRAM_MESSAGES=200
HARVEST_AUTH_GLOBAL_INTERVAL=3600
HARVEST_AUTH_GLOBAL_MESSAGES=1000
HARVEST_AUTH_GLOBAL_CHATS=30
HARVEST_AUTH_GLOBAL_QUERIES=pan.quark.cn/s/,夸克网盘,4K,短剧,合集
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/telegram-harvester
HARVEST_SMTP_HOST=smtp.gmail.com
HARVEST_SMTP_PORT=465
HARVEST_SMTP_USER=
HARVEST_SMTP_APP_PASSWORD=
HARVEST_REPORT_TO=
