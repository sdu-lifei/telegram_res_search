[Unit]
Description=Telegram Resource Search
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/telegram-res-search
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/telegram-res-search/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8888 --log-level warning
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
