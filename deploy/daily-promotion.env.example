# Keep the real file at /home/ubuntu/.config/pansou-promotion.env with mode 0600.
PROMOTION_SITE_URL=https://panss.dpdns.org
PROMOTION_STATE_PATH=/home/ubuntu/.local/state/pansou/daily-promotion.json

# Enable any one or more of these owned channels. Never commit real values.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social

MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=

# TELEGRAM_CHANNEL_ID should be a public @channel username so the workflow can
# record the public post URL. The bot must be a channel administrator.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

DISCORD_WEBHOOK_URL=
