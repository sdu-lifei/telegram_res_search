[Unit]
Description=PanSou Next.js Frontend
After=network-online.target telegram-res-search.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/pansou-frontend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/local/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
